# ---------------------------------------------------------------------------
# qlab environment — EVERYTHING here is OPTIONAL.
# The full local demo (offline synthetic data + simulated paper broker +
# DuckDB registry) runs with none of these set.
# Copy to `.env` and fill in only the integrations you actually want.
# ---------------------------------------------------------------------------

# --- QCI Dirac-3 (optional; enables the continuous-MVSK solver arm A4) -------
# Without these the dirac3 adapter refuses to run and the pipeline falls back
# to the classical MVSK multistart solver.
QCI_API_URL=
QCI_API_TOKEN=

# --- Alpaca (optional; enables the paper-trading execution gateway) ---------
# PAPER MODE IS HARD-CODED. Live trading is unimplemented by design.
# Without these, the trader uses the in-process simulated paper broker.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# --- Local runtime paths (optional) -----------------------------------------
# QLAB_WORKSPACE defaults to this source checkout (or the current directory
# for an installed wheel). QLAB_STATE_DIR defaults to $QLAB_WORKSPACE/.lab.
QLAB_WORKSPACE=
QLAB_STATE_DIR=
# Override only when loading a separately managed mandate/config/agent bundle.
QLAB_CONFIG_ROOT=

# --- Runtime wiring (optional) -----------------------------------------------
# Port the owner runtime listens on; also the port the MCP server's
# owner-alive guard checks. Default 8765.
QLAB_UI_PORT=
# Default data mode for MCP servers: 1 = offline (cache/synthetic), 0 = online.
QLAB_OFFLINE=
# Owner API base URL used by the qlab-operator proxy launched under the TUI.
# Default http://127.0.0.1:8765.
QLAB_RUNTIME_URL=
