# ---------------------------------------------------------------------------
# qlab environment — EVERYTHING here is OPTIONAL.
# The full local demo (offline synthetic data + simulated paper broker +
# DuckDB registry) runs with none of these set.
#
# qlab DOES read `.env`: `qlab/env.py` loads it into the process environment as
# the first thing `main()` does, so copying this file to `.env` and filling in
# what you need is enough — that is also where `qlab news-setup` writes what it
# is told. Exporting the same names into the environment that starts qlab (your
# shell profile, `export ...`, direnv, or a launcher) does the same job, and an
# already-exported value wins over the file:
#
#     export QLAB_DATA_PROVIDER=alpaca && qlab tui
# ---------------------------------------------------------------------------

# --- QCI Dirac-3 (optional; enables the continuous-MVSK solver arm A4) -------
# Without these the dirac3 adapter refuses to run and the pipeline falls back
# to the classical MVSK multistart solver.
QCI_API_URL=
QCI_API_TOKEN=

# --- Market data / Alpaca (optional) ----------------------------------------
# Daily-bar provider: yfinance by default; set to alpaca for adjusted Alpaca
# stock bars. Alpaca data requires the trader extra and both credentials below.
QLAB_DATA_PROVIDER=
# Alpaca execution is PAPER-ONLY. Live trading is unimplemented by design.
#
# The two keys below are optional, and are NOT the preferred path. Prefer:
#
#     alpaca profile login        # browser OAuth, paper-only by construction
#
# That flow authorizes a paper account in your browser and writes a profile
# under ~/.config/alpaca; qlab reads the active profile when no env credentials
# are set, so there is no secret to paste or keep in a file. Live access via the
# CLI needs its separate `--api-key --live` path, which qlab never takes.
#
# If you use keys instead, mind two traps:
#   * They must be EXPORTED (see the note at the top) — writing them into `.env`
#     does nothing, because qlab never reads that file.
#   * The name differs from the Alpaca CLI's: the CLI calls the secret
#     ALPACA_SECRET_KEY, qlab reads ALPACA_API_SECRET. Setting only one of the
#     pair is refused loudly rather than silently falling back to a profile.
#
# With neither source, the trader uses the in-process simulated paper broker;
# choosing QLAB_DATA_PROVIDER=alpaca instead fails loudly rather than changing
# providers.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Quote feed for live market data. IEX is the widely available Alpaca feed;
# SIP requires an entitlement. These are NOT interchangeable and the desk
# always names which one it priced against.
ALPACA_FEED=

# --- News (optional) ---------------------------------------------------------
# synthetic (default) = deterministic fixtures, NOT real headlines.
# alpaca              = ticker-tagged at the source, uses the keys above.
# rss                 = curated feeds in configs/news_sources.yaml.
# Verify with:  qlab news-check
QLAB_NEWS_PROVIDER=

# --- Atlas, the desk manager (optional) --------------------------------------
# Seconds between heartbeats (default 30). Atlas ticks, observes, and
# recomposes its read on this cadence. Keep it under 120: the owner's anomaly
# staleness bound is a fixed 120s that does not scale with this value, so a
# slower beat makes the AUTHORITY card read "not measured yet" between beats.
QLAB_ATLAS_INTERVAL_S=
# Seed autonomy on at startup. This is a runtime switch you own from the desk
# (Atlas view -> AUTONOMY), so this only sets the initial value. It never
# widens authority: the MODE decides what may run, so autonomy in Observe mode
# still launches nothing.
QLAB_ATLAS_AUTONOMOUS=

# --- Local runtime paths (optional) -----------------------------------------
# QLAB_WORKSPACE defaults to this source checkout (or the current directory
# for an installed wheel). QLAB_STATE_DIR defaults to $QLAB_WORKSPACE/.lab.
QLAB_WORKSPACE=
QLAB_STATE_DIR=
# Override only when loading a separately managed mandate/config/agent bundle.
QLAB_CONFIG_ROOT=

# --- Runtime wiring (optional) -----------------------------------------------
# Port the owner runtime listens on; also the port the MCP server's
# owner-alive guard checks. Default 8765.
QLAB_UI_PORT=
# Default data mode for MCP servers: 1 = offline (cache/synthetic), 0 = online.
QLAB_OFFLINE=
# Owner API base URL used by the qlab-operator proxy launched under the TUI.
# Default http://127.0.0.1:8765.
QLAB_RUNTIME_URL=
