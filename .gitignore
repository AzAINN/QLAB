# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Lab state (registry, artifacts, cache, summaries) — regenerated, never committed
.lab/
# ...and the archives `qlab --restart` makes of it. Same content, same reasons,
# and at ~100 MB a directory one `git add -A` away from the remote.
.lab-archive/

# Local secrets
.env

# Machine-local orchestration state and personal scratch
.claude/settings.local.json
.claude/launch.json
# Worktrees this tooling registers inside the checkout. Ignored here rather
# than in `.git/info/exclude`, which does not travel to a clone.
.claude/worktrees/
.superpowers/
codex-info-log/

# The Ratatui client's tracing sink. `qlab tui` execs the binary in the
# operator's cwd, so this lands wherever the desk was started from — the repo
# root included. `clients/atlas-tui/.gitignore` cannot reach here, and a tracked
# runtime log is appended on every launch and permanently dirties the tree.
/atlas.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Media production material — kept local. The rendered video is delivered by
# upload, not from the repo, and the scripts that produce it are working files.
media/voiceover/
media/demo/*.tape
media/demo/*.mp4
media/demo/*.gif

# Azain's own running notes.
/TODO.md

# Internal working record — dated status, plans, reviews and ledgers stay local.
# The exceptions are the eight the public docs cite: README's three
# negative-result write-ups, the Bob options doc, and the standing-authority
# set that the completion record links onward to. Adding a link from README or
# docs/ to any other file here means un-ignoring it in the same commit, or it
# renders as a 404 on GitHub.
/planning-docs/*
!/planning-docs/2026-07-26-ibm-bob-integration-options.md
!/planning-docs/2026-07-30-ml-lane.md
!/planning-docs/2026-07-30-optimizer-audit.md
!/planning-docs/2026-08-31-a6-cardinality-not-promoted.md
!/planning-docs/2026-09-01-pre-push-review-findings.md
!/planning-docs/2026-09-01-standing-authority-completion.md
!/planning-docs/2026-09-01-standing-authority-design.md
!/planning-docs/2026-09-01-standing-authority-plan.md

# Logo candidates rendered while picking a project mark. Scratch output, not the
# artwork itself — a chosen logo belongs in media/ under its own name.
/.logo/
