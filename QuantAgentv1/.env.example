# ---------------------------------------------------------------------------
# qlab environment — EVERYTHING here is OPTIONAL.
# The full local demo (offline synthetic data + Aer simulator + simulated
# paper broker + DuckDB registry) runs with none of these set.
# Copy to `.env` and fill in only the integrations you actually want.
# ---------------------------------------------------------------------------

# --- Market data (optional; yfinance needs no key) --------------------------
# Alpha Vantage is only used as a documented alternate data source.
ALPHAVANTAGE_KEY=

# --- QCI Dirac-3 (optional; enables the continuous-MVSK solver arm A4) -------
# Without these the dirac3 adapter refuses to run and the pipeline falls back
# to the classical MVSK multistart solver.
QCI_API_URL=
QCI_API_TOKEN=

# --- IBM Quantum (optional; enables running QAOA on REAL hardware) ----------
# Without this, the quantum arm runs on the local Aer simulator (free, no
# account). With it, the final optimized circuit can be sampled on hardware.
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=

# --- Alpaca (optional; enables the paper-trading execution gateway) ---------
# PAPER MODE IS HARD-CODED. Live trading is unimplemented by design.
# Without these, the trader uses the in-process simulated paper broker.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true
